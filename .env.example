# Set this in the Railway dashboard as a generated secret
MYSQL_ROOT_PASSWORD=

# Optional: import a database dump on the first start of an empty volume.
# MYSQL_INIT_DUMP_URL takes precedence if both are set. See README.md.
# MYSQL_INIT_DUMP_URL=https://example.com/dumps/seed.sql.gz
# MYSQL_INIT_DUMP_BASE64=
